#!/bin/bash

#$ -M jdasilv2@nd.edu   # Email address for job notification
#$ -m abe              # Send mail when job begins, ends and aborts
#$ -pe smp 12          # Specify parallel environment and legal core size
#$ -q long             # Specify queue
#$ -N model_analysis   # Specify job name
conda activate HFStudy
#cd ../../AnalyticaML
#pip install .
#cd ../model-evolution/scripts

./notify.sh "STARTING" "0 -- 1250"
HF_HUB_CACHE=tmp/hf_cache HF_HUB_ENABLE_HF_TRANSFER=1 python analyze_commit_history.py --group_type recent --begin 0 --end 1250
./notify.sh "DONE" "0 -- 1250"

./notify.sh "STARTING" "1250 -- 2500"
HF_HUB_CACHE=tmp/hf_cache HF_HUB_ENABLE_HF_TRANSFER=1 python analyze_commit_history.py --group_type recent --begin 1250 --end 2500
./notify.sh "DONE" "1250 -- 2500"

./notify.sh "STARTING" "2500 -- 5000"
HF_HUB_CACHE=tmp/hf_cache HF_HUB_ENABLE_HF_TRANSFER=1 python analyze_commit_history.py --group_type recent --begin 2500 --end 5000
./notify.sh "DONE" "2500 -- 5000"

./notify.sh "STARTING" "5000 -- 7500"
HF_HUB_CACHE=tmp/hf_cache HF_HUB_ENABLE_HF_TRANSFER=1 python analyze_commit_history.py --group_type recent --begin 5000 --end 7500
./notify.sh "DONE" "5000 -- 7500"

./notify.sh "STARTING" "7500 -- 10000"
HF_HUB_CACHE=tmp/hf_cache HF_HUB_ENABLE_HF_TRANSFER=1 python analyze_commit_history.py --group_type recent --begin 7500 --end 10000
./notify.sh "DONE" "7500 -- 10000"


./notify.sh "STARTING" "10000 -- end"
HF_HUB_CACHE=tmp/hf_cache HF_HUB_ENABLE_HF_TRANSFER=1 python analyze_commit_history.py --group_type recent --begin 10000
./notify.sh "DONE" "10000 -- end"

